<?xml version="1.0"?>
<package format="3">
  <name>paint_controller_ros2</name>
  <version>0.0.0</version>
  <description>A ROS 2 package for the paint controller node with Qt6 UI (Python and C++ versions)</description>
  <maintainer email="hychowah@gmail.com">c3spray_deck</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- Python dependencies -->
  <build_depend>rclpy</build_depend>
  <build_depend>PySide6</build_depend>
  
  <!-- C++ dependencies -->
  <build_depend>rclcpp</build_depend>
  <build_depend>qtbase5-dev</build_depend>
  <build_depend>libqt5quick5</build_depend>
  <build_depend>qtdeclarative5-dev</build_depend>
  <build_depend>libgstreamer1.0-dev</build_depend>
  <build_depend>libgstreamer-plugins-base1.0-dev</build_depend>
  
  <!-- Common dependencies -->
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>paint_interfaces</build_depend>
  <!-- <build_depend>teknic_interfaces</build_depend> -->

  <!-- Python runtime dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>PySide6</exec_depend>
  <exec_depend>matplotlib</exec_depend>
  
  <!-- C++ runtime dependencies -->
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>libqt5quick5</exec_depend>
  <exec_depend>qml-module-qtquick2</exec_depend>
  <exec_depend>gstreamer1.0-plugins-good</exec_depend>
  <exec_depend>gstreamer1.0-plugins-bad</exec_depend>
  
  <!-- Common runtime dependencies -->
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>paint_interfaces</exec_depend>
  <!-- <exec_depend>teknic_interfaces</exec_depend> -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
