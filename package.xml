<?xml version="1.0"?>
<package format="3">
  <name>paint_controller_ros2</name>
  <version>0.1.0</version>
  <description>ROS2 paint controller node with PySide6/QML UI for Steam Deck</description>
  <maintainer email="hychowah@gmail.com">c3spray_deck</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Python dependencies -->
  <build_depend>rclpy</build_depend>

  <!-- Common dependencies -->
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>paint_interfaces</build_depend>

  <!-- Python runtime dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>paint_interfaces</exec_depend>

  <!-- Test dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
