<?xml version="1.0"?>
<package format="3">
  <name>paint_controller</name>
  <version>0.0.0</version>
  <description>A ROS 2 package for the paint controller node with a PySide6 UI</description>
  <maintainer email="hychowah@gmail.com">c3spray_deck</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
 <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <build_depend>rclpy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>PySide6</build_depend>
  <build_depend>paint_interfaces</build_depend>
  <build_depend>teknic_interfaces</build_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>PySide6</exec_depend>
  <exec_depend>matplotlib</exec_depend>
  <exec_depend>paint_interfaces</exec_depend>
  <exec_depend>teknic_interfaces</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
